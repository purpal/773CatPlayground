  "equipment_rules": {
    "bone_visible": "!broken && !boneOut; hide idle overlay while matching melee hazard is active",
    "bone_drop": "onBossBreak at hpRatio <= 0.35, LostProp.BONE; cosmetic particle, not a pickup",
    "cap_drop": "onBossPhaseChanged to phase 2 at hpRatio <= 0.25, LostProp.HAT; cosmetic particle",
    "temporary_throw": "boneOut hides only held weapon; return restores it unless boss has broken",
    "throw_cancellation": "onBossBreak kills active ThrownBone and clears boneOut; do not show returning weapon after permanent disarm"
  },
